# Symora — environment template
#
# Copy to .env.local and fill in. NEVER commit a filled-in file.
#
# RULE: anything prefixed VITE_ is inlined into the browser bundle and is PUBLIC.
# Never give a secret a VITE_ prefix. Everything else is server-only and must never
# reach the frontend. See .claude/rules/auth-security.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployment, used for links and callbacks.
APP_BASE_URL=

# ---------------------------------------------------------------------------
# Firebase Web SDK — CLIENT-SAFE (public by design)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — SERVER ONLY (token verification)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Full private key including the BEGIN/END lines, with newlines escaped as \n.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Client-safe: project URL and anon key (RLS applies to the anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER ONLY. The service-role key BYPASSES RLS. Never expose it to the browser,
# never log it, and use it only in the repository layer after user_id has been
# established from a verified Firebase token.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migration tooling.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# AI provider — SERVER ONLY
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Cheap model for routine parsing and drafting.
AI_MODEL_CHEAP=
# Stronger model, used only for complex cases.
AI_MODEL_STRONG=
AI_REQUEST_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Speech-to-text — SERVER ONLY (Phase 7)
# ---------------------------------------------------------------------------
SPEECH_PROVIDER=
SPEECH_API_KEY=

# ---------------------------------------------------------------------------
# Usage quotas (Phase 8)
# ---------------------------------------------------------------------------
# Monthly per-user AI request allowance.
AI_MONTHLY_REQUEST_ALLOWANCE=

# ---------------------------------------------------------------------------
# Feature flags — future scope stays off. Do not enable without an explicit request.
# ---------------------------------------------------------------------------
FEATURE_VOICE_INPUT=false
FEATURE_NOTIFICATIONS=false
