# Symora — environment template
#
# Copy to .env.local and fill in. NEVER commit a filled-in file.
#
# RULE: anything prefixed VITE_ is inlined into the browser bundle and is PUBLIC.
# Never give a secret a VITE_ prefix. Everything else is server-only and must never
# reach the frontend. See .claude/rules/auth-security.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployment, used for links and callbacks.
APP_BASE_URL=

# ---------------------------------------------------------------------------
# Firebase Web SDK — CLIENT-SAFE (public by design)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — SERVER ONLY (token verification)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Full private key including the BEGIN/END lines, with newlines escaped as \n.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Client-safe: project URL and anon key (RLS applies to the anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER ONLY. The service-role key BYPASSES RLS. Never expose it to the browser,
# never log it, and use it only in the repository layer after user_id has been
# established from a verified Firebase token.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migration tooling.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# AI model — SERVER ONLY, and OPTIONAL
# ---------------------------------------------------------------------------
# Leave all of this blank to run in offline mode. Everything deterministic still works —
# payments, commitments, reminders, notifications, memory, the home screen, export and
# delete. Typed and spoken requests are understood by the rule-based parser in
# packages/core/src/ai/offline/ instead of a model, message drafts come from templates,
# and voice uses the browser's own speech recognition.
#
# The endpoint does not have to be OpenAI. Ollama, vLLM, LM Studio, llama.cpp's server,
# Groq and Together all speak the same OpenAI-compatible API, so a model running on your
# own machine is just a different AI_BASE_URL. See docs/self-hosted-model.md.

# Where the OpenAI-compatible API lives. Blank means OpenAI's own endpoint.
#   Ollama on this machine:  http://127.0.0.1:11434/v1
#   Ollama via a tunnel:     https://ollama.example.com/v1
AI_BASE_URL=

# API key. Required when AI_BASE_URL is blank (OpenAI needs a real one). Optional for an
# endpoint you run yourself — but if that endpoint is reachable from the internet, set a
# long random value here and have your proxy require it. Ollama has NO authentication of
# its own: anything that can reach it can use it.
AI_API_KEY=
# Read as a fallback so an existing deployment keeps working unchanged.
OPENAI_API_KEY=

# Model ids. AI_MODEL_CHEAP is required to leave offline mode — a key with no model
# would fail on the first call, which is worse than never leaving offline mode.
#   Hosted example:      gpt-4o-mini
#   Self-hosted example: qwen2.5:7b-instruct
AI_MODEL_CHEAP=
# Stronger model, used only for complex cases.
AI_MODEL_STRONG=

# How Symora asks for structured output.
#   auto   (default) try the endpoint's native tool calling, fall back to JSON if refused
#   native only tool calling; fail rather than fall back
#   json   skip tool calling entirely — the safe choice for small self-hosted models,
#          many of which accept the `tools` parameter and then ignore it
AI_TOOL_MODE=

# How long to wait for the model before falling back to the rule-based parser.
# Default 12000. MUST stay below `functions.maxDuration` in vercel.json (30s) — if the
# platform kills the function first the user gets a raw 504 instead of the graceful
# fallback. A model on a CPU is exactly the slow case where that ordering matters.
AI_REQUEST_TIMEOUT_MS=

# After the endpoint fails, how long before Symora tries it again. Default 60000.
# This is the "my laptop is off" window: during it, turns go straight to the rule-based
# parser in milliseconds instead of waiting out the timeout every single time.
AI_UNREACHABLE_COOLDOWN_MS=

# ---------------------------------------------------------------------------
# Speech-to-text — SERVER ONLY, and OPTIONAL
# ---------------------------------------------------------------------------
# Server transcription needs a hosted key (AI_API_KEY / OPENAI_API_KEY with no
# AI_BASE_URL) — a self-hosted chat model is not a speech model. Without it the browser's
# Web Speech API does the recognition on the device (Chrome and Edge; Firefox hides the
# mic instead).
SPEECH_MODEL=
SPEECH_REQUEST_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Usage quotas (Phase 8)
# ---------------------------------------------------------------------------
# Monthly per-user AI request allowance, counted in calendar months in the user's own
# timezone. Leave blank for unlimited — blank means no ceiling, not a ceiling of zero.
#
# Spending it does not break anything: /api/chat stops calling the provider and the
# rule-based parser takes over, exactly as it does with no key configured, and the reply
# says the allowance is spent. Every deterministic feature is unaffected.
AI_MONTHLY_REQUEST_ALLOWANCE=

# ---------------------------------------------------------------------------
# Feature flags — future scope stays off. Do not enable without an explicit request.
# ---------------------------------------------------------------------------
FEATURE_VOICE_INPUT=false
FEATURE_NOTIFICATIONS=false
