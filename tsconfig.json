{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@symora/core": ["packages/core/src"],
      "@symora/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["api/**/*.ts"]
}
